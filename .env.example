# ── Front-end (Vite) ─────────────────────────────────────────────────────────
# Copie para .env.local e preencha. .env.local NÃO vai para o repositório.

# URL do back-end Amperê. Pode deixar VAZIO:
#   em desenvolvimento o padrão é http://localhost:3333
#   publicado na Vercel o padrão é /api (mesma origem, função serverless)
# Só preencha para apontar para um back-end em outro endereço.
VITE_API_URL=

# true  -> front consome src/data/mock.ts (modo offline de desenvolvimento)
# false -> front consome a API real
VITE_USE_MOCK=false

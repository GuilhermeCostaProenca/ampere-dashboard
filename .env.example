# ── Front-end (Vite) ─────────────────────────────────────────────────────────
# Copie para .env.local e preencha. .env.local NÃO vai para o repositório.

# URL do back-end Amperê (local: http://localhost:3333)
VITE_API_URL=

# true  -> front consome src/data/mock.ts (modo offline de desenvolvimento)
# false -> front consome a API real
VITE_USE_MOCK=false

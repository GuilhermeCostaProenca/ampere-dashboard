{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  // Os testes rodam no vitest (esbuild) e não entram no dist publicado.
  "exclude": ["src/**/*.test.ts"]
}

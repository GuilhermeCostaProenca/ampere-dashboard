# ── Back-end Amperê ──────────────────────────────────────────────────────────
# Copie para server/.env e preencha. server/.env NÃO vai para o repositório.

# Supabase — Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Porta do servidor Express
PORT=3333

# Origem do front autorizada no CORS (separe múltiplas por vírgula)
CORS_ORIGIN=http://localhost:5173

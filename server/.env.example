# ── Back-end Amperê ──────────────────────────────────────────────────────────
# Copie para server/.env e preencha. server/.env NÃO vai para o repositório.

# Supabase — Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Porta do servidor Express
PORT=3333

# Origem do front autorizada no CORS (separe múltiplas por vírgula)
CORS_ORIGIN=http://localhost:5173

# ── Visão computacional (GS2) ────────────────────────────────────────────────
# OPCIONAL: sem estas variáveis a API sobe normal e só as rotas /vision
# respondem 503 dizendo o que falta. O resto do Amperê não depende delas.

# Qual modelo multimodal lê a foto: anthropic (padrão) ou gemini
VISION_PROVIDER=anthropic

# Chave do provider escolhido — preencha só a que corresponde ao VISION_PROVIDER
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Modelo a usar. Vazio = padrão do provider
#   anthropic -> claude-sonnet-4-5-20250929
#   gemini    -> gemini-2.0-flash
VISION_MODEL=

# Limite do upload, em MB (foto de celular costuma ter 2–5 MB)
VISION_MAX_UPLOAD_MB=8

# Lado maior da imagem depois do redimensionamento, em px.
# Abaixo de ~1200 os dígitos pequenos da fatura começam a se perder.
VISION_MAX_LADO_PX=1600

# Timeout de cada chamada ao modelo, em ms
VISION_TIMEOUT_MS=45000

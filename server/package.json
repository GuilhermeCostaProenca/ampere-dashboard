{
  "name": "ampere-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API do Amperê — NILM, ingestão de leituras e agregações sobre o Star Schema",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed/index.ts",
    "simulate": "tsx src/simulator/index.ts",
    "check:perfil": "tsx src/seed/calibracao.ts",
    "check:nilm": "tsx src/nilm/avaliacao.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}